<svg xmlns="http://www.w3.org/2000/svg" width="880" height="196" viewBox="0 0 880 196" fill="none" role="img" aria-label="Stack depth">
  <defs>
    <linearGradient id="mBg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0F141B"/>
      <stop offset="100%" stop-color="#0D1117"/>
    </linearGradient>
    <linearGradient id="barA" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1F6FEB"/>
      <stop offset="100%" stop-color="#58A6FF"/>
    </linearGradient>
    <linearGradient id="barB" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#1F6FEB" stop-opacity="0.85"/>
      <stop offset="100%" stop-color="#8957E6" stop-opacity="0.85"/>
    </linearGradient>
    <linearGradient id="barC" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2B4B7A"/>
      <stop offset="100%" stop-color="#58A6FF" stop-opacity="0.7"/>
    </linearGradient>
    <radialGradient id="mGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1F6FEB" stop-opacity="0.28"/>
      <stop offset="100%" stop-color="#1F6FEB" stop-opacity="0"/>
    </radialGradient>
    <clipPath id="mClip"><rect width="880" height="196" rx="14"/></clipPath>
    <style>
      .mm { font-family: "SFMono-Regular","JetBrains Mono",Consolas,"Liberation Mono",monospace; }
      @keyframes grow1 { from { width: 0; } to { width: 470px; } }
      @keyframes grow2 { from { width: 0; } to { width: 340px; } }
      @keyframes grow3 { from { width: 0; } to { width: 205px; } }
      @keyframes drift { 0%,100% { transform: translate(0,0);} 50% { transform: translate(40px,-14px);} }
      @keyframes glint { 0% { transform: translateX(-120px); opacity:0; } 40% { opacity:.9; } 100% { transform: translateX(500px); opacity:0; } }
      .g1 { animation: grow1 1.5s cubic-bezier(.2,.8,.2,1) .1s both; }
      .g2 { animation: grow2 1.5s cubic-bezier(.2,.8,.2,1) .28s both; }
      .g3 { animation: grow3 1.5s cubic-bezier(.2,.8,.2,1) .46s both; }
      .bl { animation: drift 15s ease-in-out infinite; }
    </style>
  </defs>

  <rect width="880" height="196" rx="14" fill="url(#mBg)"/>
  <g clip-path="url(#mClip)">
    <ellipse class="bl" cx="700" cy="40" rx="280" ry="130" fill="url(#mGlow)"/>
  </g>
  <rect x="0.5" y="0.5" width="879" height="195" rx="14" fill="none" stroke="#1F2A3A"/>

  <!-- tier 1 -->
  <text class="mm" x="34" y="42" font-size="12.5" font-weight="700" letter-spacing="2.6" fill="#E6EDF3">DAILY DRIVERS</text>
  <text class="mm" x="846" y="42" font-size="11" fill="#6E7681" text-anchor="end">what I write most weeks</text>
  <rect x="34" y="52" width="470" height="9" rx="4.5" fill="#161D28"/>
  <rect class="g1" x="34" y="52" width="470" height="9" rx="4.5" fill="url(#barA)"/>

  <!-- tier 2 -->
  <text class="mm" x="34" y="105" font-size="12.5" font-weight="700" letter-spacing="2.6" fill="#E6EDF3">REGULAR USE</text>
  <text class="mm" x="846" y="105" font-size="11" fill="#6E7681" text-anchor="end">comfortable, shipped real work with</text>
  <rect x="34" y="115" width="470" height="9" rx="4.5" fill="#161D28"/>
  <rect class="g2" x="34" y="115" width="340" height="9" rx="4.5" fill="url(#barB)"/>

  <!-- tier 3 -->
  <text class="mm" x="34" y="168" font-size="12.5" font-weight="700" letter-spacing="2.6" fill="#E6EDF3">WORKING KNOWLEDGE</text>
  <text class="mm" x="846" y="168" font-size="11" fill="#6E7681" text-anchor="end">productive, still deepening</text>
  <rect x="34" y="178" width="470" height="9" rx="4.5" fill="#161D28"/>
  <rect class="g3" x="34" y="178" width="205" height="9" rx="4.5" fill="url(#barC)"/>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" width="880" height="76" viewBox="0 0 880 76" fill="none" role="img" aria-label="PRINCIPLES">
  <defs>
    <linearGradient id="bgPrinciples" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#12203A"/>
      <stop offset="45%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#0D1117"/>
    </linearGradient>
    <linearGradient id="rulePrinciples" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#58A6FF"/>
      <stop offset="55%" stop-color="#1F6FEB" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#1F6FEB" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="txtPrinciples" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#7FBBFF"/>
    </linearGradient>
    <linearGradient id="swPrinciples" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#58A6FF" stop-opacity="0"/>
      <stop offset="50%" stop-color="#58A6FF" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#58A6FF" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="glowPrinciples" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#1F6FEB" stop-opacity="0.45"/>
      <stop offset="100%" stop-color="#1F6FEB" stop-opacity="0"/>
    </radialGradient>
    <clipPath id="clipPrinciples"><rect x="0" y="0" width="880" height="76" rx="12"/></clipPath>
    <style>
      .mPrinciples { font-family: "SFMono-Regular","JetBrains Mono",Consolas,"Liberation Mono",monospace; }
      @keyframes sweepPrinciples { 0% { transform: translateX(-260px); } 100% { transform: translateX(880px); } }
      @keyframes blinkPrinciples { 0%,49% { opacity: 1; } 50%,100% { opacity: 0; } }
      @keyframes floatPrinciples { 0%,100% { transform: translateX(0); } 50% { transform: translateX(26px); } }
      .sweepPrinciples { animation: sweepPrinciples 6s ease-in-out infinite; }
      .cursorPrinciples { animation: blinkPrinciples 1.1s steps(1) infinite; }
      .orbPrinciples { animation: floatPrinciples 12s ease-in-out infinite; }
    </style>
  </defs>

  <rect width="880" height="76" rx="12" fill="url(#bgPrinciples)"/>
  <g clip-path="url(#clipPrinciples)">
    <ellipse class="orbPrinciples" cx="70" cy="38" rx="200" ry="90" fill="url(#glowPrinciples)"/>
    <rect class="sweepPrinciples" x="0" y="0" width="260" height="1.5" fill="url(#swPrinciples)"/>
  </g>
  <rect x="0.5" y="0.5" width="879" height="75" rx="12" fill="none" stroke="#1F2A3A"/>

  <rect x="26" y="22" width="3" height="32" rx="1.5" fill="#58A6FF"/>

  <text class="mPrinciples" x="44" y="36" font-size="18" font-weight="700" letter-spacing="3.5" fill="url(#txtPrinciples)">// PRINCIPLES</text>
  <rect class="cursorPrinciples" x="233" y="24" width="9" height="15" fill="#58A6FF"/>

  <text class="mPrinciples" x="44" y="56" font-size="11.5" letter-spacing="1.2" fill="#6E7681">how I make engineering decisions</text>

  <text class="mPrinciples" x="854" y="45" font-size="11" letter-spacing="1" fill="#30363D" text-anchor="end">./principles.sh</text>
  <path d="M44 64 H320" stroke="url(#rulePrinciples)" stroke-width="1.5"/>
</svg>
